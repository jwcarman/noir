<?xml version="1.0" encoding="UTF-8"?>
<!-- Fetches noir's container toolchain at image build time. Not a real project. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jwcarman.noir</groupId>
  <artifactId>noir-toolchain</artifactId>
  <version>1</version>
  <packaging>pom</packaging>

  <properties>
    <junit.version>6.1.3</junit.version>
    <pitest.version>1.30.1</pitest.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>${junit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest-command-line</artifactId>
      <version>${pitest.version}</version>
    </dependency>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest-junit5-plugin</artifactId>
      <version>${pitest-junit5-plugin.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>junit</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeGroupIds>org.junit.platform</includeGroupIds>
              <stripVersion>true</stripVersion>
              <outputDirectory>/opt/noir/lib/junit</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>pitest</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <excludeGroupIds>org.junit.platform</excludeGroupIds>
              <outputDirectory>/opt/noir/lib/pitest</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
