// noir grader security policy. The console launcher runs under a SecurityManager (installed with
// -Djava.security.policy==, which replaces the default policy). Builder code is untrusted: it may
// read system properties and its own classes/jars, and use the temp directory, nothing else.
// In particular it cannot touch /work/out, exit or halt the JVM, add shutdown hooks, or replace
// the security manager.

// noir tooling: JUnit launcher.
grant codeBase "file:/opt/noir/lib/-" {
  permission java.security.AllPermission;
};

// Sealed holdout tests, compiled by grade.sh.
grant codeBase "file:/work/out/holdout-classes/-" {
  permission java.security.AllPermission;
};

// Builder classes and dependencies.
grant codeBase "file:/work/classes/-" {
  permission java.util.PropertyPermission "*", "read";
  permission java.io.FilePermission "/work/classes/-", "read";
  permission java.io.FilePermission "/work/deps/-", "read";
  permission java.io.FilePermission "${java.io.tmpdir}", "read,write,delete";
  permission java.io.FilePermission "${java.io.tmpdir}${/}-", "read,write,delete";
};

grant codeBase "file:/work/deps/-" {
  permission java.util.PropertyPermission "*", "read";
  permission java.io.FilePermission "/work/classes/-", "read";
  permission java.io.FilePermission "/work/deps/-", "read";
  permission java.io.FilePermission "${java.io.tmpdir}", "read,write,delete";
  permission java.io.FilePermission "${java.io.tmpdir}${/}-", "read,write,delete";
};
